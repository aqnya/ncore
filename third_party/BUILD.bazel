load("@rules_cc//cc:cc_library.bzl", "cc_library")

_LZ4_DIR = "lz4/lib"
_BZIP2_DIR = "bzip2"
_LZO_DIR = "lzo/minilzo"

# zlib ships its own Bazel package; expose it under the `//third_party:zlib`
# label so the rest of the build has a single dependency entry point.
alias(
    name = "zlib",
    actual = "//third_party/zlib:zlib",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bzip2",
    srcs = [
        _BZIP2_DIR + "/blocksort.c",
        _BZIP2_DIR + "/bzlib.c",
        _BZIP2_DIR + "/compress.c",
        _BZIP2_DIR + "/crctable.c",
        _BZIP2_DIR + "/decompress.c",
        _BZIP2_DIR + "/huffman.c",
        _BZIP2_DIR + "/randtable.c",
    ],
    hdrs = [_BZIP2_DIR + "/bzlib.h"],
    textual_hdrs = [_BZIP2_DIR + "/bzlib_private.h"],
    includes = [_BZIP2_DIR],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "lzo",
    srcs = [_LZO_DIR + "/minilzo.c"],
    hdrs = [_LZO_DIR + "/minilzo.h"],
    textual_hdrs = glob(["lzo/include/lzo/*.h"]),
    includes = [
        _LZO_DIR,
        "lzo/include",
        "lzo/include/lzo",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "lz4",
    srcs = [_LZ4_DIR + "/lz4.c"],
    hdrs = [
        _LZ4_DIR + "/lz4.h",
        _LZ4_DIR + "/lz4.c",
    ],
    strip_include_prefix = _LZ4_DIR,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "lz4_hc",
    srcs = [_LZ4_DIR + "/lz4hc.c"],
    hdrs = [
        _LZ4_DIR + "/lz4hc.h",
    ],
    strip_include_prefix = _LZ4_DIR,
    deps = [":lz4"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "xxhash",
    srcs = [_LZ4_DIR + "/xxhash.c"],
    hdrs = [_LZ4_DIR + "/xxhash.h"],
    strip_include_prefix = _LZ4_DIR,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "lz4_frame",
    srcs = [_LZ4_DIR + "/lz4frame.c"],
    hdrs = [
        _LZ4_DIR + "/lz4frame.h",
        _LZ4_DIR + "/lz4frame_static.h",
    ],
    strip_include_prefix = _LZ4_DIR,
    deps = [
        ":lz4",
        ":lz4_hc",
        ":xxhash",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "lz4_file",
    srcs = [_LZ4_DIR + "/lz4file.c"],
    hdrs = [_LZ4_DIR + "/lz4file.h"],
    strip_include_prefix = _LZ4_DIR,
    deps = [
        ":lz4_frame",
        ":lz4",
    ],
    visibility = ["//visibility:public"],
)

_XZ_DIR = "xz/src/liblzma"
_XZ_COMMON_DIR = "xz/src/common"

cc_library(
    name = "xz",
    srcs = glob([
        _XZ_DIR + "/check/*.c",
        _XZ_DIR + "/common/*.c",
        _XZ_DIR + "/delta/*.c",
        _XZ_DIR + "/lz/*.c",
        _XZ_DIR + "/lzma/*.c",
        _XZ_DIR + "/rangecoder/*.c",
        _XZ_DIR + "/simple/*.c",
    ], exclude = [
        _XZ_DIR + "/check/crc32_tablegen.c",
        _XZ_DIR + "/check/crc64_tablegen.c",
        _XZ_DIR + "/check/crc_clmul_consts_gen.c",
        _XZ_DIR + "/check/crc32_small.c",
        _XZ_DIR + "/check/crc64_small.c",
        _XZ_DIR + "/lzma/fastpos_tablegen.c",
        _XZ_DIR + "/rangecoder/price_tablegen.c",
    ]),
    hdrs = [
        _XZ_DIR + "/api/lzma.h",
    ],
    textual_hdrs = glob([
        _XZ_DIR + "/api/lzma/*.h",
        _XZ_DIR + "/check/*.h",
        _XZ_DIR + "/common/*.h",
        _XZ_DIR + "/delta/*.h",
        _XZ_DIR + "/lz/*.h",
        _XZ_DIR + "/lzma/*.h",
        _XZ_DIR + "/rangecoder/*.h",
        _XZ_DIR + "/simple/*.h",
        _XZ_COMMON_DIR + "/*.h",
    ]) + ["xz_bazel/config.h"],
    includes = [
        "xz_bazel",
        _XZ_DIR + "/api",
        _XZ_DIR + "/check",
        _XZ_DIR + "/common",
        _XZ_DIR + "/delta",
        _XZ_DIR + "/lz",
        _XZ_DIR + "/lzma",
        _XZ_DIR + "/rangecoder",
        _XZ_DIR + "/simple",
        _XZ_COMMON_DIR,
    ],
    defines = [
        "HAVE_CONFIG_H",
        "MYTHREAD_POSIX",
    ],
    strip_include_prefix = _XZ_DIR + "/api",
    visibility = ["//visibility:public"],
)